<Window x:Class="pr6_Styles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr6_Styles"
        mc:Ignorable="d"
        Background="{DynamicResource Background}"
        Title="Фитнес" Height="550" Width="700">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="0">
            <Button Content="Сменить тему" x:Name="btnChangeTheme" Click="btnChangeTheme_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Выбор тренировки:" FontSize="18" FontWeight="Bold"/>
            <ComboBox x:Name="WorkoutCombo" SelectedIndex="0">
                <ComboBoxItem Content="Кардио-тренировка"/>
                <ComboBoxItem Content="Силовая тренировка"/>
                <ComboBoxItem Content="Йога и растяжка"/>
            </ComboBox>

            <TextBlock Text="Индикатор выполнения:" Margin="0,15,0,0"/>
            <ProgressBar x:Name="WorkoutProgress" Value="50" Maximum="100"/>
            
            <CheckBox x:Name="AgreeCheckBox" Content="Подтвердить готовность к нагрузке" Margin="0,15,0,0"/>

            <TextBlock Text="Введите показатели (пульс/вес):" Margin="0,10,0,0"/>
            <TextBox x:Name="MetricsInput" Height="30" Margin="5"/>

            <TextBlock Text="Введите противопоказания/заметки: " Margin="0,10,0,0"/>
            <TextBox x:Name="NotesInput" TextWrapping="Wrap" Height="80" Margin="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>



            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton x:Name="BeginnerRadio" Content="Новичок" IsChecked="True"/>
                <RadioButton x:Name="ProRadio" Content="Профи"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Начать тренировку" x:Name="StartWorkoutbtn" Click="StartWorkoutbtn_Click" IsEnabled="{Binding ElementName=AgreeCheckBox, Path=IsChecked}"/>
            <Button Content="Сбросить" x:Name="Resetbtn" Click="Resetbtn_Click" />
            <!-- Опасное действие с именованным стилем и блокировкой -->
            <Button Content="Экстренная остановка" x:Name="Stopbtn" Click="Stopbtn_Click" Style="{StaticResource DangerButtonStyle}" 
                    IsEnabled="{Binding ElementName=AgreeCheckBox, Path=IsChecked}"/>
        </StackPanel>
    </Grid>
</Window>
